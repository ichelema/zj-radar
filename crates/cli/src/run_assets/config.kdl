// zj-radar run: owned Zellij config. The WASM token is replaced with the
// absolute materialized wasm path at first run. Theme inherits Zellij defaults;
// the keybinds block below is ADDITIVE (Zellij merges it with the defaults), so
// every default chord still works — it only adds the Alt-1..9 tab jumps.
plugins {
    radar location="file:@WASM@" {
        naming "managed"
        // No `jump_hint` here, deliberately: this config DOES bind Alt-1..9
        // (below), but the chord only reaches Zellij when nothing upstream
        // claims it first — window managers commonly own Alt+digit system-wide
        // (AeroSpace workspaces, most tiling WMs), and macOS terminals type `¡`
        // unless option-as-alt is on. The rail can't detect interception, so
        // the footer stays quiet rather than promise a chord that may never
        // arrive. The binds themselves stay for keyboards where it does.
    }
}

keybinds {
    shared_except "locked" {
        // alt-[n]: jump straight to tab n — the rail shows the numbers. The
        // footer does NOT advertise this chord (see the plugins block above);
        // it's an unadvertised nicety. Additive (defaults keep working); only
        // sessions created by `zj-radar run` get these binds. Bound in
        // `shared_except "locked"` (Zellij's idiom for global chords) so they
        // fire from normal use but not from locked mode.
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
    }
}
